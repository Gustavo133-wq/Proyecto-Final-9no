  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df = pd.read_csv('emi_contratos_limpio.csv')\n",
    "\n",
    "def inferir_area(asignatura):\n",
    "    a = unidecode(str(asignatura).lower())\n",
    "    if any(k in a for k in ['red', 'administracion de red']): return 'REDES'\n",
    "    if any(k in a for k in ['base de dato']): return 'BASES_DE_DATOS'\n",
    "    if any(k in a for k in ['program', 'python', 'java', 'software', 'web']): return 'PROGRAMACION'\n",
    "    if any(k in a for k in ['inteligencia']): return 'INTELIGENCIA_ARTIFICIAL'\n",
    "    if any(k in a for k in ['seguridad', 'forense']): return 'SEGURIDAD'\n",
    "    if any(k in a for k in ['sistema operativo', 'arquitectura', 'digital']): return 'SISTEMAS'\n",
    "    if any(k in a for k in ['calculo', 'algebra', 'estadistica', 'ecuacion',\n",
    "                             'fisica', 'probabilidad', 'estocastico']): return 'MATEMATICAS'\n",
    "    if any(k in a for k in ['estructura de dato', 'algoritmo']): return 'ALGORITMOS'\n",
    "    return 'GESTION'\n",
    "\n",
    "if 'AREA' not in df.columns:\n",
    "    df['AREA'] = df['ASIGNATURA'].apply(inferir_area)\n",
    "\n",
    "print(f\"✅ Dataset: {len(df)} contratos, {df['CEDULA'].nunique()} docentes, {df['ASIGNATURA'].nunique()} asignaturas\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 🕸️ 2. Construcción del grafo bipartito"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# ─── Grafo bipartito ponderado ────────────────────────────────────────────────\n",
    "# Nodos tipo 'D': docentes  (prefijo 'D_')\n",
    "# Nodos tipo 'A': asignaturas (prefijo 'A_')\n",
    "# Aristas: D_cedula ↔ A_asignatura, peso = monto del contrato\n",
    "\n",
    "G = nx.Graph()\n",
    "\n",
    "# Agregar nodos docentes con atributos\n",
    "docentes_info = df.groupby('CEDULA').agg(\n",
    "    nombre=('NOMBRE', 'first'),\n",
    "    grado=('GRADO', 'first'),\n",
    "    n_contratos=('NRO', 'count'),\n",
    "    monto_total=('MONTO', 'sum'),\n",
    ").reset_index()\n",
    "\n",
    "for _, row in docentes_info.iterrows():\n",
    "    G.add_node(\n",
    "        f\"D_{row['CEDULA']}\",\n",
    "        tipo='docente',\n",
    "        nombre=row['nombre'],\n",
    "        grado=row['grado'],\n",
    "        n_contratos=int(row['n_contratos']),\n",
    "        monto_total=float(row['monto_total']),\n",
    "    )\n",
    "\n",
    "# Agregar nodos asignaturas con atributos\n",
    "asig_info = df.groupby('ASIGNATURA').agg(\n",
    "    area=('AREA', 'first'),\n",
    "    n_contratos=('NRO', 'count'),\n",
    "    monto_total=('MONTO', 'sum'),\n",
    ").reset_index()\n",
    "\n",
    "for _, row in asig_info.iterrows():\n",
    "    G.add_node(\n",
    "        f\"A_{row['ASIGNATURA']}\",\n",
    "        tipo='asignatura',\n",
    "        nombre=row['ASIGNATURA'],\n",
    "        area=row['area'],\n",
    "        n_contratos=int(row['n_contratos']),\n",
    "        monto_total=float(row['monto_total']),\n",
    "    )\n",
    "\n",
    "# Agregar aristas ponderadas (un contrato = una arista)\n",
    "for _, row in df.iterrows():\n",
    "    n_doc = f\"D_{row['CEDULA']}\"\n",
    "    n_asi = f\"A_{row['ASIGNATURA']}\"\n",
    "    if G.has_edge(n_doc, n_asi):\n",
    "        G[n_doc][n_asi]['weight'] += float(row['MONTO'])\n",
    "        G[n_doc][n_asi]['contratos'] += 1\n",
    "    else:\n",
    "        G.add_edge(n_doc, n_asi,\n",
    "                   weight=float(row['MONTO']),\n",
    "                   contratos=1,\n",
    "                   modalidad=row['MODALIDAD'])\n",
    "\n",
    "nodos_doc = [n for n, d in G.nodes(data=True) if d['tipo'] == 'docente']\n",
    "nodos_asi = [n for n, d in G.nodes(data=True) if d['tipo'] == 'asignatura']\n",
    "\n",
    "print(f\"✅ Grafo bipartito construido:\")\n",
    "print(f\"   Nodos docentes    : {len(nodos_doc)}\")\n",
    "print(f\"   Nodos asignaturas : {len(nodos_asi)}\")\n",
    "print(f\"   Aristas           : {G.number_of_edges()}\")\n",
    "print(f\"   Densidad          : {nx.density(G):.6f}\")\n",
    "print(f\"   Bipartito         : {nx.is_bipartite(G)}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": ["## 📊 3. Análisis de centralidad del grafo"]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Centralidad de grado: cuántas asignaturas imparte cada docente\n",
    "grado_docentes = {n: d for n, d in G.degree(nodos_doc)}\n",
    "\n",
    "# Centralidad de grado ponderada: suma de montos por docente\n",
    "grado_pond = {n: sum(G[n][v]['weight'] for v in G.neighbors(n)) for n in nodos_doc}\n",
    "\n",
    "# Centralidad de intermediación (betweenness): qué docentes son puentes entre asignaturas\n",
    "between = nx.betweenness_centrality(G, weight='weight', normalized=True)\n",
    "between_doc = {n: between[n] for n in nodos_doc}\n",
    "\n",
    "# Tabla de centralidades\n",
    "df_centralidad = pd.DataFrame({\n",
    "    'grado': grado_docentes,\n",
    "    'monto_total': grado_pond,\n",
    "    'intermediacion': between_doc,\n",
    "}).reset_index()\n",
    "df_centralidad.columns = ['nodo', 'grado', 'monto_total', 'intermediacion']\n",
    "df_centralidad['cedula'] = df_centralidad['nodo'].str.replace('D_', '')\n",
    "df_centralidad = df_centralidad.merge(\n",
    "    docentes_info[['CEDULA','nombre','grado']],\n",
    "    left_on='cedula', right_on='CEDULA', how='left'\n",
    ")\n",
    "df_centralidad = df_centralidad.sort_values('monto_total', ascending=False)\n",
    "\n",
    "print(\"Top 15 docentes por centralidad de monto:\")\n",
    "print(df_centralidad[['nombre','grado_y','grado_x','monto_total','intermediacion']]\n",
    "      .head(15).round(4).to_string(index=False))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [\n",
    "## 🔢 4. PageRank sobre el grafo\n",
    "\n",
    "PageRank asigna importancia a cada nodo según la importancia de sus vecinos. En este contexto: un docente es más importante si imparte asignaturas que tienen muchos docentes competentes, y viceversa."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# PageRank con pesos (monto del contrato como peso de arista)\n",
    "pagerank_scores = nx.pagerank(\n",
    "    G,\n",
    "    alpha=0.85,       # factor de amortiguamiento estándar de Google\n",
    "    weight='weight',  # usar monto como peso\n",
    "    max_iter=100,\n",
    "    tol=1.0e-6\n",
    ")\n",
    "\n",
    "# Separar scores por tipo de nodo\n",
    "pr_docentes    = {n: v for n, v in pagerank_scores.items() if n.startswith('D_')}\n",
    "pr_asignaturas = {n: v for n, v in pagerank_scores.items() if n.startswith('A_')}\n",
    "\n",
    "# Top docentes por PageRank\n",
    "top_pr_doc = sorted(pr_docentes.items(), key=lambda x: x[1], reverse=True)[:15]\n",
    "\n",
    "df_pr = pd.DataFrame(top_pr_doc, columns=['nodo', 'pagerank'])\n",
    "df_pr['cedula'] = df_pr['nodo'].str.replace('D_', '')\n",
    "df_pr = df_pr.merge(docentes_info[['CEDULA','nombre','grado','n_contratos','monto_total']],\n",
    "                    left_on='cedula', right_on='CEDULA', how='left')\n",
    "df_pr['pagerank_pct'] = (df_pr['pagerank'] * 100).round(4)\n",
    "\n",
    "print(\"Top 15 Docentes por PageRank (ponderado por monto):\")\n",
    "print(df_pr[['nombre','grado','n_contratos','monto_total','pagerank_pct']].to_string(index=False))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
