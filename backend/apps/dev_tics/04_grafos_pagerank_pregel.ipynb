    "ax.tick_params(axis='y', labelsize=7)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.savefig('pagerank_ranking.png', bbox_inches='tight', dpi=150)\n",
    "plt.show()"
   ]
