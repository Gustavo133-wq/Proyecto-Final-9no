  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [\n",
    "## 🔄 5. Algoritmo Pregel — PageRank iterativo\n",
    "\n",
    "Pregel procesa el grafo en **supersteps** iterativos:\n",
    "- En cada superstep, cada nodo activo envía mensajes a sus vecinos\n",
    "- Los nodos reciben mensajes y actualizan su valor de PageRank\n",
    "- Se repite hasta que los valores convergen (diferencia < epsilon)\n",
    "\n",
    "Esta implementación usa `multiprocessing` para procesar los nodos en paralelo dentro de cada superstep."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def pregel_superstep(args):\n",
    "    \"\"\"\n",
    "    Un superstep de Pregel para un subconjunto de nodos.\n",
    "\n",
    "    En cada superstep:\n",
    "    1. Cada nodo recibe mensajes de sus vecinos (sus PageRanks actuales)\n",
    "    2. Aplica la fórmula PageRank: PR(v) = (1-d)/N + d * Σ PR(u)/grado(u)\n",
    "    3. Retorna el nuevo PageRank del nodo\n",
    "    \"\"\"\n",
    "    nodo, vecinos_con_pesos, pageranks_actuales, d, N = args\n",
    "\n",
    "    # Suma ponderada de PageRanks de vecinos\n",
    "    suma = 0.0\n",
    "    for vecino, peso_arista, grado_vecino in vecinos_con_pesos:\n",
    "        if vecino in pageranks_actuales and grado_vecino > 0:\n",
    "            # Contribución ponderada por el peso de la arista\n",
    "            suma += pageranks_actuales[vecino] * (peso_arista / grado_vecino)\n",
    "\n",
    "    nuevo_pr = (1 - d) / N + d * suma\n",
    "    return (nodo, nuevo_pr)\n",
    "\n",
    "\n",
    "def pagerank_pregel(\n",
    "    grafo: nx.Graph,\n",
    "    d: float = 0.85,\n",
    "    max_iter: int = 50,\n",
    "    epsilon: float = 1e-6,\n",
    "    n_workers: int = None\n",
    ") -> tuple:\n",
    "    \"\"\"\n",
    "    PageRank implementado con el modelo Pregel + multiprocessing.\n",
    "\n",
    "    Returns:\n",
    "        (pageranks, historial_convergencia, iteraciones)\n",
    "    \"\"\"\n",
    "    if n_workers is None:\n",
    "        n_workers = mp.cpu_count()\n",
    "\n",
    "    nodos = list(grafo.nodes())\n",
    "    N     = len(nodos)\n",
    "\n",
    "    # Inicializar PageRank uniforme\n",
    "    pageranks = {n: 1.0 / N for n in nodos}\n",
    "\n",
    "    # Precomputar estructura: para cada nodo, sus vecinos con pesos y grado total\n",
    "    estructura = {}\n",
    "    for nodo in nodos:\n",
    "        vecinos = list(grafo.neighbors(nodo))\n",
    "        grado_total = sum(grafo[nodo][v].get('weight', 1) for v in vecinos)\n",
    "        estructura[nodo] = [\n",
    "            (v, grafo[nodo][v].get('weight', 1), grado_total)\n",
    "            for v in vecinos\n",
    "        ]\n",
    "\n",
    "    historial = []\n",
    "    t_inicio  = time.perf_counter()\n",
    "\n",
    "    for superstep in range(max_iter):\n",
    "        t_step = time.perf_counter()\n",
    "\n",
    "        # Preparar argumentos para los workers\n",
    "        args_workers = [\n",
    "            (nodo, estructura[nodo], dict(pageranks), d, N)\n",
    "            for nodo in nodos\n",
    "        ]\n",
    "\n",
    "        # Ejecutar superstep en paralelo\n",
    "        with mp.Pool(processes=n_workers) as pool:\n",
    "            resultados = pool.map(pregel_superstep, args_workers)\n",
    "\n",
    "        nuevos_pageranks = dict(resultados)\n",
    "\n",
    "        # Calcular convergencia (norma L1 de la diferencia)\n",
    "        diferencia = sum(abs(nuevos_pageranks[n] - pageranks[n]) for n in nodos)\n",
    "\n",
    "        t_dur = (time.perf_counter() - t_step) * 1000\n",
    "        historial.append({\n",
    "            'superstep': superstep + 1,\n",
    "            'diferencia': diferencia,\n",
    "            'tiempo_ms':  t_dur,\n",
    "        })\n",
    "\n",
    "        pageranks = nuevos_pageranks\n",
    "\n",
    "        if superstep % 5 == 0 or diferencia < epsilon:\n",
    "            print(f\"  Superstep {superstep+1:>3}: Δ={diferencia:.8f}  |  {t_dur:.1f}ms\")\n",
    "\n",
    "        if diferencia < epsilon:\n",
    "            print(f\"\\n  ✅ Convergencia alcanzada en superstep {superstep+1}\")\n",
    "            break\n",
    "\n",
    "    t_total = (time.perf_counter() - t_inicio) * 1000\n",
    "    print(f\"\\n  ⏱ Tiempo total Pregel: {t_total:.1f}ms | {n_workers} workers paralelos\")\n",
    "\n",
    "    return pageranks, pd.DataFrame(historial), superstep + 1\n",
    "\n",
    "\n",
    "print(\"✅ Algoritmo Pregel implementado\")\n",
    "print(f\"   Workers disponibles: {mp.cpu_count()}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Ejecutar Pregel sobre el grafo bipartito completo\n",
    "print(\"=\" * 60)\n",
    "print(\"EJECUTANDO PAGERANK CON PREGEL\")\n",
    "print(f\"Grafo: {G.number_of_nodes()} nodos, {G.number_of_edges()} aristas\")\n",
    "print(\"=\" * 60)\n",
    "\n",
    "pr_pregel, df_convergencia, n_iter = pagerank_pregel(\n",
    "    G, d=0.85, max_iter=50, epsilon=1e-6\n",
    ")\n",
    "\n",
    "# Comparar con NetworkX PageRank para validar\n",
    "pr_nx = nx.pagerank(G, alpha=0.85, weight='weight', max_iter=100, tol=1e-6)\n",
    "\n",
    "# Error medio absoluto entre ambas implementaciones\n",
    "mae = np.mean([abs(pr_pregel[n] - pr_nx[n]) for n in G.nodes()])\n",
    "print(f\"\\n📊 Validación vs NetworkX PageRank:\")\n",
    "print(f\"   Error Medio Absoluto (MAE): {mae:.2e}\")\n",
    "print(f\"   Implementaciones equivalentes: {'✅ SÍ' if mae < 1e-4 else '⚠️ Revisar'}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Visualizar curva de convergencia de Pregel\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "ax = axes[0]\n",
    "ax.semilogy(df_convergencia['superstep'], df_convergencia['diferencia'],\n",
    "            'o-', color=COLORES['primario'], linewidth=2.5, markersize=5)\n",
    "ax.axhline(1e-6, color=COLORES['peligro'], linestyle='--',\n",
    "           linewidth=1.5, label='Umbral de convergencia (ε=1e-6)')\n",
    "ax.fill_between(df_convergencia['superstep'], df_convergencia['diferencia'],\n",
